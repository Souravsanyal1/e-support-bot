# ==============================================================================
# Celia System & Group Management Bot - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file or share secrets publicly.
# ==============================================================================

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter API Key (Optional for GPT-4o: https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
AI_PROVIDER=openrouter

# Google Gemini API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Optional, defaults to gemini-2.5-flash)
# Options include: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Administrator Telegram User ID(s)
# Can be configured as single TELEGRAM_ADMIN_ID or comma-separated ADMIN_USER_IDS
# Numeric Telegram user IDs only (obtainable via @userinfobot or similar on Telegram)
TELEGRAM_ADMIN_ID=
ADMIN_USER_IDS=

# Timezone for scheduled timer and telemetry (defaults to Asia/Dhaka)
TIMEZONE=Asia/Dhaka

# Operation Mode: 'polling' (default, free-tier friendly) or 'webhook'
BOT_MODE=polling

# Webhook Settings (Only required if BOT_MODE=webhook)
PORT=3000
WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_here

# Anti-Spam Rate Limiting Settings
# Maximum messages allowed per user within the time window
RATE_LIMIT_MAX_MESSAGES=10
# Time window in seconds for the rate limit
RATE_LIMIT_WINDOW_SECONDS=60

# ==============================================================================
# OpenAI Moderation Endpoint (100% FREE - No tokens charged)
# ==============================================================================
# Get a free key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
MODERATION_FAIL_CLOSED=false

# ==============================================================================
# Auto-Updating Knowledge System Settings
# ==============================================================================
# Enable or disable automatic synchronization (default: true)
ENABLE_KNOWLEDGE_SYNC=true
# Synchronization interval in minutes (recommended: 10-15)
KNOWLEDGE_SYNC_INTERVAL_MINUTES=15
# Destination path for the automatically synchronized Markdown knowledge
KNOWLEDGE_FILE_PATH=knowledge/elite-force-knowledge.md
# Official portal URLs for scraping and fact synchronization
OFFICIAL_WEBSITE_URL=https://elite-force.space
OFFICIAL_TIMER_URL=https://timer.elite-force.space

# ==============================================================================
# Inappropriate Image Detection & Auto-Moderation (Req 18)
# ==============================================================================
# Enable or disable image moderation in community chats (default: true)
ENABLE_IMAGE_MODERATION=true
# Comma-separated Telegram group chat IDs to moderate (leave empty to moderate all groups)
MODERATION_GROUP_IDS=
# Moderation provider: 'openai' (free omni-moderation), 'gemini', or 'openrouter'
IMAGE_MODERATION_PROVIDER=openai
# Confidence threshold for flagging inappropriate/nude images (0.0 to 1.0, default: 0.80)
IMAGE_MODERATION_CONFIDENCE_THRESHOLD=0.80
# Timeout in milliseconds for image moderation API calls (default: 10000)
IMAGE_MODERATION_TIMEOUT_MS=10000
# Exact warning message sent to the group when an inappropriate image is deleted
IMAGE_MODERATION_WARNING_MESSAGE=⚠️ Inappropriate, adult, or nude images are strictly prohibited in Elite Force community chats.
